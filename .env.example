# Copy this file to .env and fill in real values. .env is gitignored
# and must never be committed.

# --- Database ---
# DB_DRIVER: "sqlite" for zero-setup local/demo use, "mysql" for production.
DB_DRIVER=sqlite
DB_HOST=localhost
DB_NAME=event_registration
DB_USER=root
DB_PASS=
# Only used when DB_DRIVER=sqlite
DB_SQLITE_PATH=sql/event_registration.sqlite

# --- AI features ---
# Leave blank to run the AI features in stub/demo mode (deterministic,
# templated responses - no external calls, no cost). Fill in a real key
# to get genuine AI-generated descriptions, Q&A answers, and recommendations.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=claude-sonnet-5
